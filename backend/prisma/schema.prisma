generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Atendimento {
  id              Int      @id @default(autoincrement())
  data            String?
  tecnico         String?
  cliente         String
  contato         String?
  telefone        String?
  descricao       String?
  tipo            String
  osAberta        String?
  resolvidoRemoto String?
  critico         String?
  posSuporte      String?
  status          String?
  observacoes     String?
  createdAt       DateTime @default(now())
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  login        String   @unique
  senha        String
  perfil       String   @default("atendente")
  ativo        Boolean  @default(true)
  ultimoLogin  DateTime?
  createdAt    DateTime @default(now())
}