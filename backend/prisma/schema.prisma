generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Atendimento {
  id                    Int      @id @default(autoincrement())
  data                  String?
  tecnico               String?
  cliente               String
  contato               String?
  telefone              String?
  descricao             String?
  tipo                  String
  osAberta              String?
  resolvidoRemoto       String?
  resolvidoInternamente String?
  critico               String?
  posSuporte            String?
  status                String?
  observacoes           String?
  createdAt             DateTime @default(now())
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nome         String
  email        String    @unique
  login        String    @unique
  senha        String
  perfil       String    @default("Atendente")
  ativo        Boolean   @default(true)
  online       Boolean   @default(false)
  ultimoLogin  DateTime?
  resetToken   String?   @unique
  resetExpira  DateTime?
  createdAt    DateTime  @default(now())
}

model Convite {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  nome      String?
  email     String?
  login     String?
  perfil    String    @default("Atendente")
  usado     Boolean   @default(false)
  usadoEm   DateTime?
  expiraEm  DateTime?
  criadoPor String?
  createdAt DateTime  @default(now())
}
